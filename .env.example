# Server control plane. Use long random values in production.
PROSMET_ADMIN_TOKEN=
PROSMET_AGENT_CONFIG_KEY=
PROSMET_AGENT_CONFIG_FILE=
PROSMET_DEFAULT_AGENT_ID=

# OpenAI-compatible provider
PROSMET_OPENAI_COMPATIBLE_BASE_URL=
PROSMET_OPENAI_COMPATIBLE_MODEL=
PROSMET_OPENAI_COMPATIBLE_KEY_ENV=OPENAI_API_KEY
OPENAI_API_KEY=

# Ollama
PROSMET_OLLAMA_BASE_URL=http://127.0.0.1:11434
PROSMET_OLLAMA_MODEL=
PROSMET_OLLAMA_TOOLS=1

# Codex App Server
PROSMET_CODEX_ENABLED=0
PROSMET_CODEX_MODEL=
PROSMET_CODEX_CWD=
PROSMET_CODEX_TIMEOUT_MS=180000

# AG-UI / A2A gateways
PROSMET_AGUI_URL=
PROSMET_AGUI_ENDPOINT=
PROSMET_AGUI_KEY_ENV=AGUI_API_KEY
AGUI_API_KEY=

PROSMET_A2A_URL=
PROSMET_A2A_ENDPOINT=
PROSMET_A2A_KEY_ENV=A2A_API_KEY
A2A_API_KEY=

# Native app backend
EXPO_PUBLIC_PROSMET_API_URL=https://kolibriai.online
