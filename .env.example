# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/prosmet
AUTH_SECRET=replace-with-at-least-32-random-characters

# Provider routing (server-side only)
AGENT_PROVIDER=deterministic
MIMO_API_BASE_URL=
MIMO_API_KEY=
MIMO_MODEL=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Optional deployment on the self-hosted primary runner
PROSMET_DEPLOY_DIR=/opt/prosmet
PROSMET_CANARY_PORT=18080
