{
  "name": "prosmet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium --with-deps --no-shell",
    "source:contract": "node scripts/source-contract.mjs",
    "assistant-ui:info": "npx --yes assistant-ui@latest info",
    "check": "npm run source:contract && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@ag-ui/client": "^0.0.57",
    "@ag-ui/core": "^0.0.57",
