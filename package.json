{
  "name": "prosmet",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0 <23"
  },
  "scripts": {
    "copy:wasm": "node scripts/copy-sql-wasm.mjs",
    "postinstall": "npm run copy:wasm",
    "predev": "npm run copy:wasm",
    "dev": "next dev",
    "prebuild": "npm run copy:wasm",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3100",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "source:contract": "node scripts/source-contract.mjs",
    "verify": "npm run source:contract && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@ag-ui/client": "^0.0.57",
    "@ag-ui/core": "^0.0.57",
    "@assistant-ui/react": "latest",
    "@assistant-ui/react-ag-ui": "latest",
    "@assistant-ui/react-markdown": "latest",
    "better-auth": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "latest",
    "exceljs": "^4.4.0",
    "jose": "^6.1.3",
    "lucide-react": "latest",
    "next": "^16.2.11",
    "pdfmake": "^0.2.20",
    "pg": "latest",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-gfm": "^4.0.1",
    "sql.js": "^1.13.0",
    "tailwind-merge": "^3.6.0",
    "zod": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/pdfmake": "latest",
    "@types/pg": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "postcss": "latest",
    "tailwindcss": "latest",
    "tw-animate-css": "latest",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "latest"
  }
}
