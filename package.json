{
  "name": "prosmet",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/csp-bundle-contract.mjs",
    "start": "next start -H 0.0.0.0 -p 3100",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:migrate": "node deployment/migrate-postgres.mjs",
    "cleanup:universal": "node scripts/cleanup-universal-duplicates.mjs",
    "source:contract": "npm run cleanup:universal && node scripts/source-contract-v2.mjs && node scripts/compact-estimate-workspace-contract.mjs && node scripts/https-premium-foundation-contract.mjs && node scripts/agent-instructions-contract.mjs && node scripts/premium-ui-refactor-contract.mjs && node scripts/server-runtime-contract.mjs && node scripts/schema-migration-contract.mjs && node scripts/rules-agent-runtime-contract.mjs && node scripts/pdf-export-contract.mjs && node scripts/price-sync-contract.mjs && node scripts/provider-runtime-contract.mjs && node scripts/a2a-developer-mode-contract.mjs && node scripts/universal-platform-contract.mjs",
    "verify": "npm run source:contract && npm run typecheck && npm run test && npm run build",
    "engine:build": "cargo build --release -p prosmet-engine",
    "engine:test": "cargo test -p prosmet-engine",
    "admin:bootstrap": "node scripts/bootstrap-superadmin.mjs",
    "universal:contract": "node scripts/universal-platform-contract.mjs",
    "mobile:typecheck": "npm run typecheck --prefix apps/mobile",
    "desktop:check": "cargo check --manifest-path apps/desktop/src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@ag-ui/client": "^0.0.57",
    "@ag-ui/core": "^0.0.57",
    "@assistant-ui/react": "latest",
    "@assistant-ui/react-ag-ui": "latest",
    "@assistant-ui/react-markdown": "latest",
    "better-auth": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "latest",
    "exceljs": "^4.4.0",
    "jose": "^6.1.3",
    "lucide-react": "latest",
    "next": "^16.2.11",
    "pdfmake": "^0.2.20",
    "pg": "latest",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/pdfmake": "latest",
    "@types/pg": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "postcss": "latest",
    "tailwindcss": "latest",
    "tw-animate-css": "latest",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "latest"
  }
}
