{
  "name": "@prosmet/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src/domain/user-session.test.ts src/application/user-session.test.ts",
    "test:watch": "vitest src/domain/user-session.test.ts src/application/user-session.test.ts",
    "test:coverage": "vitest run --coverage src/domain/user-session.test.ts src/application/user-session.test.ts",
    "test:integration": "vitest run src/application/user-session.test.ts",
    "verify": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@assistant-ui/react-native": "0.1.33",
    "@prosmet/contracts": "0.1.0",
    "expo": "~57.0.0",
    "expo-secure-store": "~57.0.0",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "5.8.0"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.10"
  }
}
